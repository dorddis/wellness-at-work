# Ignore desktop app (not needed for web deployment)
apps/desktop

# Ignore large cache files (>100MB limit)
.turbo
**/.next/cache
node_modules/.cache
*.log
*.pack
*.pack.gz
*.tar.zst

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/tests
**/__tests__

# Ignore local SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Ignore Electron release builds
**/release
**/dist-electron

# Ignore IDE and OS files
.idea
.vscode
*.swp
*.swo
.DS_Store
Thumbs.db
