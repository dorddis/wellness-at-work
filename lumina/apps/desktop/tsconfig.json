{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@lumina/core": ["../../packages/core/src"],
      "@lumina/core/*": ["../../packages/core/src/*"],
      "@lumina/ui": ["../../packages/ui/src"],
      "@lumina/ui/*": ["../../packages/ui/src/*"],
      "@lumina/api": ["../../packages/api/src"],
      "@lumina/api/*": ["../../packages/api/src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/ui/src/**/*", "../../packages/core/src/**/*", "../../packages/api/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
