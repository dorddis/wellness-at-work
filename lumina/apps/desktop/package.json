{
  "name": "@lumina/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Lumina Desktop - AI wellness coach",
  "author": "Lumina Team",
  "repository": "https://github.com/dorddis/wellness-at-work.git",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "package": "electron-builder",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "cross-env ELECTRON_RUN_AS_NODE=true electron node_modules/vitest/vitest.mjs --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@lumina/api": "workspace:*",
    "@lumina/core": "workspace:*",
    "@lumina/ui": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.18",
    "better-sqlite3": "^12.5.0",
    "electron-store": "^10.0.0",
    "motion": "^11.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.lumina.desktop",
    "productName": "Lumina",
    "electronVersion": "39.2.7",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-e3da78107a3f4e5c9db5419df773c20f.r2.dev"
      }
    ],
    "files": [
      "dist/**/*"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "afterSign": "scripts/notarize.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
