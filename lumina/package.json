{
  "name": "lumina",
  "version": "1.4.0",
  "private": true,
  "description": "B2B AI wellness platform for enterprises",
  "author": "Lumina Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/dorddis/wellness-at-work.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "turbo dev --filter=@lumina/desktop",
    "dev:web": "turbo dev --filter=@lumina/web",
    "build": "turbo build",
    "build:desktop": "turbo build --filter=@lumina/desktop",
    "build:web": "turbo build --filter=@lumina/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.50.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
